SIFT_ENV=development
# Meta Model API key (dev.meta.ai -> API keys). Without it the Lab Agent runs offline.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SIFT_CHAT_MODEL=muse-spark-1.3
# minimal|low|medium|high|xhigh|max. Reasoning tokens share the max_tokens budget.
SIFT_REASONING_EFFORT=minimal
SIFT_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SIFT_TRANSCRIBE_PATH=/asr/transcribe
SIFT_SAM_MODEL=sam-3.1
# SAM 3.1 segments over the Responses API; override only if the API path moves.
SIFT_SAM_PATH=/responses
SIFT_DB=sift.db
# Empty means the in-process limiter (one worker). Set to redis://... to share limits across workers.
SIFT_REDIS_URL=
# Comma-separated app origins. '*' is refused when SIFT_ENV=production.
SIFT_CORS=*
SIFT_TRUST_PROXY=0
SIFT_REQUIRE_KEY=0
# When 1, calibration writes (samples, train) and validation truth need an X-Sift-Key. Reads stay open.
SIFT_PROTECT_CALIBRATION=0
# 24+ characters. Leave empty to disable key management.
SIFT_ADMIN_TOKEN=
# Requests per minute per client
SIFT_RATE_PUBLIC=30
SIFT_RATE_KEYED=240
SIFT_RATE_AGENT=20
SIFT_MAX_IMAGE_BYTES=12582912
SIFT_MAX_AUDIO_BYTES=8388608
SIFT_MAX_JSON_BYTES=2097152
SIFT_MAX_USER_TEXT=500
