# Meta Model API key (dev.meta.ai -> API keys). Without it the Lab Agent runs offline.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SIFT_CHAT_MODEL=muse-spark-1.3
SIFT_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SIFT_SAM_MODEL=sam-3.1
# Confirm this path against dev.meta.ai/docs/models before relying on SAM segmentation.
SIFT_SAM_PATH=/segment
SIFT_DB=sift.db
SIFT_CORS=*
SIFT_REQUIRE_KEY=0
SIFT_ADMIN_TOKEN=
